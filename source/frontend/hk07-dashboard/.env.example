# ─────────────────────────────────────────────────────────────────────────────
# HK-07 // HUGO SANITAS — Frontend (Vue 3 + Vite) Environment Template
# Copy to `.env` (or `.env.local`) and adjust for your environment.
#   cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the Spring Boot REST API.
# - Docker/Nginx deployment: leave as the relative default "/api/v1" (Nginx proxies it).
# - Local dev against a backend on port 8888:
#     VITE_API_URL=http://localhost:8888/api/v1
VITE_API_URL=/api/v1

# STOMP-over-SockJS WebSocket endpoint.
# - Docker/Nginx deployment: leave as the relative default "/ws".
# - Local dev against a backend on port 8888:
#     VITE_WS_URL=http://localhost:8888/ws
VITE_WS_URL=/ws
