# ─────────────────────────────────────────────────────────────────────────────
# HK-07 // HUGO SANITAS — Backend Environment Template
# Copy this file to `.env` (same directory) and replace every CHANGE_ME value.
#   cp .env.example .env
# NOTE: `.env` is git-ignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL) ───────────────────────────────────────────────────────
DB_HOST=hk07-mysql
DB_PORT=3306
DB_DATABASE=hk07db
DB_USERNAME=hk07user
DB_PASSWORD=CHANGE_ME_db_password
# Root password used only by the MySQL container bootstrap.
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# ── Redis (token cache + throttle buffer) ────────────────────────────────────
REDIS_HOST=hk07-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://hk07-redis:6379/0

# ── MQTT Broker (Eclipse Mosquitto) ──────────────────────────────────────────
# Shared password for the hk07core / hk07agent / hk07sim broker accounts.
# The mosquitto container generates its password file from MQTT_PASSWORD at start.
MQTT_PASSWORD=CHANGE_ME_mqtt_password
# Core (Spring Boot) connection settings:
MQTT_BROKER_URL=tcp://hk07-mosquitto:1883
MQTT_USERNAME=hk07core
# Agent / sensors / robotics connection settings:
MQTT_BROKER_HOST=hk07-mosquitto
MQTT_BROKER_PORT=1883

# ── Security (JWT) ───────────────────────────────────────────────────────────
# MUST be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_long

# ── AI / LLM Provider API Keys — 4-Tier Group Orchestration Matrix ───────────
# TIER 1 (Text/Tool-Calling Only — GROQ is the SOLE orchestrator)
#
# NOTE: The actual template has these commented comments but let's keep them exactly the same.
# We'll just replace the relevant lines around 54-58
# Let's target lines 54-58 precisely.
# Wait, let's keep it clean:
# we target the lines around 54-58:
# AGENT_ENGINE_URL=http://hk07-agent:8000
# HK07_CORE_URL=http://hk07-core:8888
# INTERNAL_API_KEY=CHANGE_ME_internal_api_key_bypass


# ── AI / LLM Provider API Keys — 4-Tier Group Orchestration Matrix ───────────
# TIER 1 (Text/Tool-Calling Only — GROQ is the SOLE orchestrator)
GROQ_API_KEY=

# TIER 2 (Concurrent Cloud Vision Cluster — OpenAI + Gemini race, 2.5s budget)
OPENAI_API_KEY=
GEMINI_API_KEY=

# TIER 3 (Emergency Local Edge — Ollama moondream/qwen2b, see Ollama section below)
# No API key required — runs on localhost:11434

# TIER 4 (Background Non-Critical — EXCLUDED from real-time vision sync path)
# Used only for background text processing and health-log tasks
COHERE_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
MISTRAL_API_KEY=

# ── Inter-service URLs ───────────────────────────────────────────────────────
AGENT_ENGINE_URL=http://hk07-agent:8889
AGENT_PORT=8889
HK07_CORE_URL=http://hk07-core:8888
INTERNAL_API_KEY=CHANGE_ME_internal_api_key_bypass

# ── AI Agent → Core auth (for fire-and-forget audit log ingestion) ───────────
AGENT_AUTH_EMAIL=owner@hk07.local
AGENT_AUTH_PASSWORD=CHANGE_ME_agent_account_password

# ── LanceDB (vector memory) ──────────────────────────────────────────────────
LANCE_DB_PATH=./data/lance_memory

# ── Phone & Sensors (WSL / Hotspot Bridge) ───────────────────────────────────
# Updated automatically by robotics/hugo_network_arm.bat on each hotspot connect
PHONE_IP=192.168.X.X
WIFI_IP=192.168.X.X
FUSION_PORT=5007

# ── Local Edge Vision-LLM (Ollama) ───────────────────────────────────────────
# Install: https://ollama.com  |  Run: `OLLAMA_HOST=0.0.0.0 ollama serve` + `ollama pull moondream`
# IMPORTANT: Ollama MUST be bound to 0.0.0.0 (not 127.0.0.1) for Docker/WSL access.
# Activates when TIER 2 cloud cluster times out (2.5s) or is circuit-broken.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_VISION_TIMEOUT_S=8.0

# ── Robot Mode Configuration ──────────────────────────────────────────────
# Mode: SIMULATED (default dev simulation profile) or PRODUCTION (only real telemetry)
ROBOT_MODE=SIMULATED
# Docker/WSL bridge fallback host (auto-probed when localhost is unreachable)
OLLAMA_BRIDGE_HOST=172.17.0.1

# ── Headless Sensor Ingestion Daemon ─────────────────────────────────────────
# Polls IPWebcam and sensor fusion buffer at fixed interval, regardless of
# which frontend route is currently active (/companion, /sensor-telemetry etc)
SENSOR_DAEMON_POLL_S=0.5
SENSOR_DAEMON_BACKOFF_S=5.0
# Port for IPWebcam Android app stream (default: 8080)
CAMERA_PORT=8080
