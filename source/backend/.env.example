# ─────────────────────────────────────────────────────────────────────────────
# HK-07 // HUGO SANITAS — Backend Environment Template
# Copy this file to `.env` (same directory) and replace every CHANGE_ME value.
#   cp .env.example .env
# NOTE: `.env` is git-ignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL) ───────────────────────────────────────────────────────
DB_HOST=hk07-mysql
DB_PORT=3306
DB_DATABASE=hk07db
DB_USERNAME=hk07user
DB_PASSWORD=CHANGE_ME_db_password
# Root password used only by the MySQL container bootstrap.
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# ── Redis (token cache + throttle buffer) ────────────────────────────────────
REDIS_HOST=hk07-redis
REDIS_PORT=6379

# ── MQTT Broker (Eclipse Mosquitto) ──────────────────────────────────────────
# Shared password for the hk07core / hk07agent / hk07sim broker accounts.
# The mosquitto container generates its password file from MQTT_PASSWORD at start.
MQTT_PASSWORD=CHANGE_ME_mqtt_password
# Core (Spring Boot) connection settings:
MQTT_BROKER_URL=tcp://hk07-mosquitto:1883
MQTT_USERNAME=hk07core
# Agent / sensors / robotics connection settings:
MQTT_BROKER_HOST=hk07-mosquitto
MQTT_BROKER_PORT=1883

# ── Security (JWT) ───────────────────────────────────────────────────────────
# MUST be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_long

# ── AI / LLM Provider API keys (fill in at least one) ────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ── Inter-service URLs ───────────────────────────────────────────────────────
AGENT_ENGINE_URL=http://hk07-agent:8889
HK07_CORE_URL=http://hk07-core:8888

# ── AI Agent → Core auth (for fire-and-forget audit log ingestion) ───────────
AGENT_AUTH_EMAIL=owner@hk07.local
AGENT_AUTH_PASSWORD=CHANGE_ME_agent_account_password

# ── LanceDB (vector memory) ──────────────────────────────────────────────────
LANCE_DB_PATH=./data/lance_memory
