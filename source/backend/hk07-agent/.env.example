# API Keys for HK-07 Multi-Agent System
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# AgentLogClient — Internal Spring Boot Core authentication
AGENT_AUTH_EMAIL=owner@hk07.local
AGENT_AUTH_PASSWORD=HK07-Admin-Change-Me!

# Port for FastAPI Agent Engine
AGENT_PORT=8889

# MQTT Broker Configuration
MQTT_PASSWORD=hk07_mqtt_dev_pwd
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Redis Blackboard
# Use redis://hk07-redis:6379/0 when running the agent inside docker-compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Local Edge AI / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5
OLLAMA_VISION_MODEL=moondream
